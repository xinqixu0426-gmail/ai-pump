    {"id":"B14","rule":"Price/template change does not rewrite history; impact is distinct from confirmed effect.","serviceExports":["businessChanges","businessImpact","orderRevisions"],"api":["GET /api/business-changes","POST /api/relations/resolve"],"tests":["tests/businessChanges.test.cjs","tests/businessImpactEnforcement.test.cjs","tests/orderRevisions.test.cjs"],"evidence":"api/services/businessChanges.cjs; api/services/businessImpact*.cjs"},
    {"id":"B15","rule":"File inspection, business attachment, and knowledge archive are separately authorized.","serviceExports":["inspectFactoryFile","archiveFactoryFile","knowledgeSyncCommand"],"api":["/api/factory-files/*","/api/knowledge/*"],"tests":["tests/factoryFileLifecycleCommands.test.cjs","tests/knowledgeDocuments.test.cjs","tests/aiAttachmentRouting.test.cjs"],"evidence":"api/services/factoryFileStore.cjs; api/routes/ai/executors/businessExecutors.cjs:733-922"},
