  "rules": [
    {"id":"B01","rule":"Names discover; stable IDs bind.","serviceExports":["lookupEntities","resolveAiToolTargetV3","resolveRecipeIdentity"],"api":["POST /api/entity-lookup","GET /api/recipes/:id"],"tests":["tests/entityLookupApi.test.cjs","tests/aiResourceResolutionV3.test.cjs","tests/recipeIdentityResolution.test.cjs"],"evidence":"api/routes/ai/internalApiClient.cjs; api/services/aiEntityResolverV3.cjs"},
    {"id":"B02","rule":"Same specification can have multiple coil schemes.","serviceExports":["createCoilQueries","calculateCoilCost"],"api":["GET /api/coils","POST /api/coils/calculate"],"tests":["tests/coilQueries.test.cjs","tests/coilVariantAmbiguity.test.cjs","tests/coilVariantExecutors.test.cjs"],"evidence":"api/services/coilQueries.cjs:64-87; api/services/coilCost.cjs:114-196"},
    {"id":"B03","rule":"Calculated and kit coil prices have different authorities.","serviceExports":["calculateCoilCost","wireWeightAuthorityForPricingMode"],"api":["POST /api/coils/calculate"],"tests":["tests/coilCost.test.cjs","tests/businessUnderstandingBenchmarkV2.test.cjs"],"evidence":"api/services/coilCost.cjs:102-106,196-228,320-359"},
    {"id":"B04","rule":"Default coil selection has context and writes need a concrete scheme.","serviceExports":["calculateCoilCost","prepareCoilStockAdjustment"],"api":["GET /api/coils","POST /api/inventory/coils/batch-stock"],"tests":["tests/coilVariantAmbiguity.test.cjs","tests/coilInventory.test.cjs"],"evidence":"api/services/coilCost.cjs:184-196; api/services/aiCoilStockExecution.cjs"},
    {"id":"B05","rule":"Recipe, template, and model string are distinct objects.","serviceExports":["createRecipeQueries","resolveRecipeIdentity"],"api":["GET /api/recipes","GET /api/recipes/:id","GET /api/templates"],"tests":["tests/recipeIdentityResolution.test.cjs","tests/pumpShellPartResolver.test.cjs"],"evidence":"api/routes/recipes.cjs:52-66,148-171"},
    {"id":"B06","rule":"Configuration changes inherit safely and clear incompatible coil state.","serviceExports":["applyRecipeBaseline","normalizeRecipeConfigurationOverrides","buildConfiguredRecipeSnapshot"],"api":["POST /api/recipes/bom-draft","POST /api/recipes/:id/cost-preview"],"tests":["tests/recipeConfigurationBaseline.test.cjs","tests/recipeConfigurationPolicy.test.cjs","tests/dynamicConfigCost.test.cjs"],"evidence":"api/services/recipeConfigurationBaseline.cjs; api/services/configuredRecipeSnapshot.cjs"},
    {"id":"B07","rule":"Current rebuild, save draft, snapshot, and preview costs are not interchangeable.","serviceExports":["calculateCurrentRecipeCost","buildRecipeCostDraft","previewRecipeCost"],"api":["GET /api/recipes/current-costs","POST /api/recipes/cost-draft","POST /api/recipes/:id/cost-preview"],"tests":["tests/currentRecipeCost.test.cjs","tests/costContract.test.cjs","tests/costQueries.test.cjs"],"evidence":"api/routes/cost.cjs:44-62,112-143; api/routes/recipes.cjs:94-103"},
    {"id":"B08","rule":"Missing price means incomplete cost and null total, never zero.","serviceExports":["costEngine","buildCurrentRecipeCostFailure"],"api":["GET /api/recipes/current-costs","POST /api/cost/full-estimate"],"tests":["tests/costEngine.test.cjs","tests/currentRecipeCost.test.cjs","tests/businessUnderstandingBenchmarkV2.test.cjs"],"evidence":"api/services/costEngine.cjs; api/services/currentRecipeCost.cjs:37-45"},
    {"id":"B09","rule":"Unknown quotation quantity is unknown; margin is a multiplier.","serviceExports":["buildQuotationDraft"],"api":["POST /api/quotations/save-payload-draft"],"tests":["tests/quotationQuantityOptional.test.cjs","tests/quotationQueries.test.cjs"],"evidence":"api/services/quotationDraft.cjs:68-91,143-174"},
    {"id":"B10","rule":"Order item snapshots do not silently refresh current cost.","serviceExports":["orderCommands","orderBomSnapshot","orderRevisions"],"api":["PATCH /api/orders/:id"],"tests":["tests/orderCommands.test.cjs","tests/orderDraftState.test.cjs","tests/orderExecutionRecords.test.cjs"],"evidence":"api/services/orderCommands.cjs; api/services/orderBomSnapshot.cjs"},
    {"id":"B11","rule":"Purchase, arrival, and stock inbound are separate state transitions.","serviceExports":["orderWorkflow","purchasingInbound","inventoryCommands"],"api":["/api/orders/*","/api/purchases/*"],"tests":["tests/orderWorkflow.test.cjs","tests/purchasingInbound.test.cjs","tests/purchaseInventory.test.cjs"],"evidence":"api/services/orderWorkflow.cjs; api/services/purchasingInbound.cjs"},
    {"id":"B12","rule":"Readiness includes active-order allocation and units.","serviceExports":["orderPlanning","buildOrderReadinessContext","orderReadiness"],"api":["GET /api/orders/:id/readiness","GET /api/orders/:id/readiness-actions"],"tests":["tests/orderPlanning.test.cjs","tests/orderReadiness.test.cjs","tests/orderReadinessOverview.test.cjs"],"evidence":"api/services/orderPlanning.cjs; api/services/activeOrderReadiness.cjs"},
