    "recipe": "CanonicalEntity(recipe)",
    "changes": "{ scenarioKey, field, from, to }[]",
    "readSet": "readSetId/readSetHash/sourceVersions",
    "costBasis": ["CURRENT_REBUILT_BASE", "CURRENT_REBUILT_SCENARIO"]
  },
  "sameReadSet": "One synchronous SQLite read transaction constructs base and all candidates from one source snapshot.",
  "resultLimits": {"maxBytes": 98304, "maxSourceVersionsReturned": 128},
  "runtimeIntegrated": false,
  "modelCalls": 0,
  "businessWrites": 0
}
