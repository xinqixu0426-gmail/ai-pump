{
  "name": "pump-bom-web-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); for (const dir of ['.next','.next-dev']) fs.rmSync(dir,{recursive:true,force:true})\"",
    "clean:build": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "clean:dev": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "dev:primary": "next dev -p 3000",
    "dev": "next dev -p 3001",
    "build": "npm run clean:build && next build",
    "rebuild": "npm run clean && npm run build",
    "start:primary": "next start -p 3000",
    "start": "next start -p 3001",
    "lint": "next lint"
  },
  "dependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "motion": "^12.23.27",
    "next": "^15.5.21",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^5.0.12"
  },
  "overrides": {
    "postcss": "^8.5.16",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "eslint": "^8.55.0",
    "eslint-config-next": "^15.5.21",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.2.2"
  }
}
