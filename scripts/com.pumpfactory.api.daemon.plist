<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pumpfactory.api</string>
  <key>UserName</key>
  <string>dan</string>
  <key>GroupName</key>
  <string>staff</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/libexec/pumpfactory-api-daemon</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/dan/pump-cost-accounting-system</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key>
    <string>production</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/dan/pump-cost-accounting-system/logs/api-launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/dan/pump-cost-accounting-system/logs/api-launchd.error.log</string>
</dict>
</plist>
