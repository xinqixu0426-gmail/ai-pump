#!/bin/zsh
set -euo pipefail

STAMP=/var/run/pumpfactory-api-log-reopen.stamp
NOW=$(/bin/date +%s)
LAST=0
if [[ -r "$STAMP" ]]; then
  LAST=$(/bin/cat "$STAMP" 2>/dev/null || /usr/bin/printf '0')
fi
if (( NOW - LAST < 60 )); then
  exit 0
fi
/usr/bin/printf '%s\n' "$NOW" > "$STAMP"
/bin/launchctl kill SIGTERM system/com.pumpfactory.api 2>/dev/null || true
