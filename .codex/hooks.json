{
  "description": "ADF completion interlock for the current project workflow.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/adf-stop.mjs\"",
            "commandWindows": "powershell -NoProfile -Command \"$root = git rev-parse --show-toplevel; node (Join-Path $root '.codex\\hooks\\adf-stop.mjs')\"",
            "timeout": 30,
            "statusMessage": "Checking ADF workflow completion"
          }
        ]
      }
    ]
  }
}
