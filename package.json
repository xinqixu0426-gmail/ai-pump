{
  "name": "pump-factory-management",
  "version": "1.0.0",
  "description": "水泵工厂管理系统 - 零件、模板、配方、报价、订单与生产协同",
  "type": "module",
  "scripts": {
    "dev": "npm run web-next:dev:primary",
    "build": "npm run web-next:build",
    "lint": "eslint api.cjs \"api/**/*.cjs\" \"scripts/**/*.cjs\" \"tests/**/*.cjs\" && npm --prefix apps/web-next run lint",
    "test": "node scripts/run-tests.cjs",
    "test:ai-architecture": "node scripts/run-ai-architecture-acceptance.cjs",
    "test:ai-shadow": "node scripts/run-ai-shadow-evaluation.cjs",
    "test:mcp": "node --test tests/mcp.test.cjs",
    "test:mcp:conformance": "node scripts/run-mcp-conformance.cjs",
    "verify:mcp-local": "npm run test:mcp && npm run test:mcp:conformance && node scripts/run-deep-api-smoke.cjs --scope=mcp",
    "verify:mcp-write-local": "node scripts/verify-mcp-write-local.cjs",
    "verify:mcp-prod-cost": "node scripts/verify-mcp-production-cost.cjs",
    "verify:mcp-prod-read": "node scripts/verify-mcp-production-read.cjs",
    "mcp:identity": "node scripts/manage-mcp-identities.cjs",
    "mcp:identity:macmini": "powershell -ExecutionPolicy Bypass -File scripts/manage-mcp-identities-macmini.ps1",
    "verify:api-contract": "node --test tests/apiContractGovernance.test.cjs tests/aiCapabilityRegistry.test.cjs",
    "test:deep-api": "node scripts/run-deep-api-smoke.cjs",
    "test:knowledge-live": "node scripts/run-knowledge-evaluation.cjs --scope=manual",
    "test:knowledge-case": "node scripts/run-knowledge-evaluation.cjs --scope=manual",
    "verify:ai-release": "node scripts/run-knowledge-evaluation.cjs --scope=release --report=logs/ai-release-gate-latest.json",
    "verify:ai-native-release": "node scripts/run-ai-native-quality-gate.cjs",
    "test:knowledge-retrieval": "node scripts/run-knowledge-retrieval-evaluation.cjs",
    "knowledge:vector-check": "node scripts/check-knowledge-vector-runtime.cjs",
    "knowledge:model-prepare": "node scripts/check-knowledge-vector-runtime.cjs --prepare-model",
    "knowledge:backup-check": "node scripts/check-knowledge-vector-backup.cjs",
    "db:backup:release": "node scripts/manage-database-backups.cjs create --type release",
    "db:backup:list": "node scripts/manage-database-backups.cjs list",
    "db:backup:verify": "node scripts/manage-database-backups.cjs verify",
    "db:restore": "node scripts/manage-database-backups.cjs restore",
    "maintenance:backfill-long-screws": "node scripts/backfill-recipe-long-screw-parts.cjs",
    "audit:catalog-references": "node scripts/audit-catalog-references.cjs",
    "deploy:macmini": "powershell -ExecutionPolicy Bypass -File scripts/deploy-macmini.ps1",
    "restart:local": "powershell -ExecutionPolicy Bypass -File scripts/restart-local-dev.ps1",
    "verify:prod-env": "node scripts/verify-production-env.cjs",
    "verify:release": "npm audit && npm --prefix apps/web-next audit && npm run verify:api-contract && npm run lint && npm test && npm run test:deep-api && npm run build && npm run verify:ai-native-release && npm run verify:prod-env",
    "preview": "npm run web-next:start:primary",
    "api": "node api.cjs",
    "web-next:dev:primary": "npm --prefix apps/web-next run dev:primary",
    "web-next:dev": "npm --prefix apps/web-next run dev",
    "web-next:clean": "npm --prefix apps/web-next run clean",
    "web-next:build": "npm --prefix apps/web-next run build",
    "web-next:rebuild": "npm --prefix apps/web-next run rebuild",
    "web-next:start:primary": "npm --prefix apps/web-next run start:primary",
    "web-next:start": "npm --prefix apps/web-next run start",
    "web-next:full": "concurrently \"npm run api\" \"npm run web-next:dev\"",
    "web-next:full:primary": "concurrently \"npm run api\" \"npm run web-next:dev:primary\"",
    "web-next:prod": "concurrently \"npm run start:prod\" \"npm run web-next:start\"",
    "start": "concurrently \"npm run api\" \"npm run dev\"",
    "start:prod": "NODE_ENV=production node api.cjs"
  },
  "keywords": [
    "BOM",
    "pump",
    "cost",
    "inventory"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@arizeai/phoenix-otel": "2.2.0",
    "@e965/xlsx": "^0.20.3",
    "@huggingface/transformers": "4.2.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@napi-rs/canvas": "0.1.100",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "adm-zip": "0.6.1",
    "better-sqlite3": "^12.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "pdfjs-dist": "5.4.296",
    "sqlite-vec": "0.1.9",
    "tesseract.js": "7.0.0",
    "word-extractor": "^1.0.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/conformance": "^0.1.16",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.55.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "adm-zip": "0.6.1",
    "sharp": "0.35.4"
  }
}
