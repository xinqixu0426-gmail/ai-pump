            "name": "成本汇总"
        },
        {
            "parameters": {
                "jsCode": "// 汇总三路成本数据\nconst items = $input.all();\n\n// 分支1: 配方成本 (from 获取水泵配方成本)\nconst recipeCost = items[0]?.json?.data?.totalCost || '0';\n\n// 分支2: 线圈转子成本 (from AI Agent1)\nlet statorCost = '0';\ntry {\n    const agentOutput = items[1]?.json?.output || items[1]?.json?.text || '{}';\n    const parsed = typeof agentOutput === 'string' ? JSON.parse(agentOutput) : agentOutput;\n    statorCost = parsed.stator_cost || '0';\n} catch(e) {\n    const match = String(items[1]?.json?.output || '').match(/stator_cost[\"\\s:]+([\\d.]+)/);\n    if (match) statorCost = match[1];\n}\n\n// 分支3: 动态配置成本 (from 动态配置)\nconst dynamicCost = items[2]?.json?.data?.totalCost || '0';\nconst dynamicDetails = items[2]?.json?.data?.details || [];\nconst resolvedWire = items[2]?.json?.data?.resolvedWire || '-';\n\n// 汇总\nconst total = (parseFloat(recipeCost) + parseFloat(statorCost) + parseFloat(dynamicCost)).toFixed(2);\n\n// 配方明细\nconst recipeDetails = items[0]?.json?.data?.details || [];\nconst recipeName = items[0]?.json?.data?.recipeName || '-';\n\n// 格式化输出\nlet summary = '📦 ' + recipeName + ' 成本核算报告\\n';\nsummary += '════════════════════════\\n';\nsummary += '\\n🔧 配方固定配件成本: ¥' + recipeCost + '\\n';\nrecipeDetails.forEach(d => {\n    summary += '   ' + d.name + '(' + d.model + '): ¥' + d.price + ' × ' + d.qty + ' = ¥' + d.subtotal + '\\n';\n});\nsummary += '\\n⚡ 线圈转子成本: ¥' + statorCost + '\\n';\nsummary += '\\n📋 动态配置成本: ¥' + dynamicCost + '\\n';\ndynamicDetails.forEach(d => {\n    summary += '   ' + d.name + '(' + d.model + '): ¥' + d.price + ' × ' + d.qty + ' = ¥' + d.subtotal + '\\n';\n});\nsummary += '\\n════════════════════════';\nsummary += '\\n💰 总成本: ¥' + total;\n\nreturn [{\n    json: {\n        summary,\n        totalCost: total,\n        breakdown: { recipeCost, statorCost, dynamicCost },\n        recipeName, recipeDetails, dynamicDetails, resolvedWire\n    }\n}];"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                448,
                -256
            ],
            "id": "a1b2c3d4-e5f6-7890-abcd-costcalcnode01",
            "name": "成本汇总计算"
        }
