                "specifyBody": "json",
                "jsonBody": "={\n  \"stator\": \"{{ $json.output.coli_rotor }}\",\n  \"cableLength\": {{ $json.output.cableLength || 0 }},\n  \"boxType\": \"{{ $json.output.boxType || '' }}\",\n  \"hasFloat\": {{ $json.output.hasFloat ?? false }}\n}",
