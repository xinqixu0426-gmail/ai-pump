ACCESS_PASSWORD=change-me
JWT_SECRET=replace-with-random-hex
INTERNAL_SECRET=replace-with-random-hex
CORS_ORIGIN=https://your.domain

NODE_ENV=development
PORT=3002
NEXT_ORIGIN=
# AI 工具调用本机 API 的最长等待时间（1000-120000 毫秒）；写操作不会自动重试。
INTERNAL_API_TIMEOUT_MS=15000

# AI Observability 默认关闭；只有精确值 true 才启用。P02 不采集任何业务内容或自动框架 span。
AI_OBSERVABILITY_ENABLED=false
AI_TRACE_CONTENT=metadata
AI_OBSERVABILITY_PROJECT=pump-ai-v4-baseline
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006

# 通用 MCP 默认关闭。默认只开放代码白名单中的只读 Query/Preview 工具。
MCP_ENABLED=false
# 单 Agent 可用 MCP_TOKEN；多 Agent 推荐用 MCP_SERVICE_TOKENS 分配独立身份和 token。
# token 必须与 INTERNAL_SECRET/JWT_SECRET/管理密码不同，至少 32 字符，例如 openssl rand -hex 32。
MCP_CLIENT_ID=default-agent
MCP_TOKEN=
# JSON 对象示例（不要提交真实 token）：{"hermes":"...","codex":"..."}
MCP_SERVICE_TOKENS=
# V2 写工具默认关闭；启用后仍需同时通过身份和工具双重白名单，并强制 MCP 原生人工确认。
MCP_WRITE_ENABLED=false
# 逗号分隔，必须与 MCP_CLIENT_ID 或 MCP_SERVICE_TOKENS 中的身份完全一致。
MCP_WRITE_CLIENT_IDS=
# JSON 对象；每个启用写权限的身份必须显式列出非空写工具数组，例如：{"codex":["sync_factory_knowledge"]}
MCP_WRITE_TOOL_ALLOWLISTS=
# 允许的 Host/Origin，多个值用逗号分隔；CORS_ORIGIN 的 hostname 会自动加入。
MCP_ALLOWED_HOSTS=
MCP_RATE_LIMIT_PER_MINUTE=60
MCP_MAX_RESULT_BYTES=262144

# 数据库备份默认写入项目 backups/；异机目录留空表示只做本机备份。
DB_BACKUP_DIR=
DB_BACKUP_MIRROR_DIR=
AUDIT_RETENTION_DAYS=365

# AI_PROVIDER 默认 auto：普通对话和本地解析成功的文档走 DeepSeek；图片、扫描/OCR、解析截断或本地解析不可用的文件按能力走 Kimi。
# local 仅使用局域网 OpenAI 兼容模型；local-first 仅在临时故障且 DeepSeek 已配置时降级。
# 本地模式默认按问题只提供相关工具；设 AI_LOCAL_TOOL_SHORTLIST_ENABLED=false 可恢复全量只读工具。
# 也可设为 deepseek 或 kimi，强制所有对话使用单一提供商。
# Kimi Coding 订阅凭证不能用于这里，业务助手需要开放平台 API Key。
# 局域网服务当前提供 Ornith 1.5 35B-A3B APEX Compact 文本模型，不支持图片理解，LOCAL_AI_VISION_ENABLED 保持 false。
AI_PROVIDER=auto
AI_ONTOLOGY_RELATION_SHADOW_ENABLED=false
AI_ONTOLOGY_RELATION_BINDING_SHADOW_ENABLED=false
AI_ONTOLOGY_2HOP_SHADOW_ENABLED=false
# Private local/local-first pure relation routing experiment; independent from shadow flags.
AI_ONTOLOGY_RELATION_ROUTING_CANARY_ENABLED=false
AI_LOCAL_TOOL_SHORTLIST_ENABLED=true
LOCAL_AI_BASE_URL=http://192.168.31.111:8080/v1
LOCAL_AI_MODEL=/var/opt/models/Ornith-1.5-35B-A3B-APEX-i-compact.gguf
LOCAL_AI_VISION_ENABLED=false
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
KIMI_API_KEY=
KIMI_MODEL=kimi-k3
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_REASONING_EFFORT=low
# 单次模型 HTTP 请求默认 120 秒；整轮 AI 对话默认 180 秒；SSE 每 15 秒发送心跳。
AI_PROVIDER_TIMEOUT_MS=120000
AI_CHAT_TIMEOUT_MS=180000
AI_SSE_HEARTBEAT_MS=15000
# 仅用于本地上下文预算的保守 token 估算；真实用量只采信供应商 usage。
AI_CONTEXT_WINDOW_TOKENS=32768
AI_RESERVED_OUTPUT_TOKENS=2048
AI_ATTACHMENT_CONTEXT_TOKENS=8192
AI_HISTORY_CONTEXT_TOKENS=4096
AI_KNOWLEDGE_EXCERPT_TOKENS=6144
AI_EVIDENCE_CONTEXT_TOKENS=16384
# R2 Fact-driven Read Investigation Runtime；默认关闭，shadow 只重放本轮正式观察且不执行额外调用。
AI_READ_INVESTIGATION_V4_ENABLED=false
AI_READ_INVESTIGATION_V4_SHADOW_ENABLED=false
AI_CLAIM_GROUNDING_V4_ENABLED=false
# 留空时按模型默认能力判断；需要显式关闭视觉输入时设为 false。
AI_VISION_ENABLED=
# 默认启用按问题领域缩小模型可见工具集；紧急回退到全部工具时设为 false。
AI_DYNAMIC_TOOL_ROUTING_ENABLED=true

# Knowledge V6 向量能力。混合检索异常时自动回退 FTS/LIKE。
KNOWLEDGE_VECTOR_ENABLED=true
KNOWLEDGE_VECTOR_AUTO_SYNC_ENABLED=true
KNOWLEDGE_HYBRID_SEARCH_ENABLED=true
KNOWLEDGE_VECTOR_BATCH_SIZE=16
KNOWLEDGE_EMBEDDING_MODEL=Xenova/multilingual-e5-small
KNOWLEDGE_EMBEDDING_DIMENSIONS=384
KNOWLEDGE_EMBEDDING_DTYPE=q8
KNOWLEDGE_MODEL_CACHE_DIR=
KNOWLEDGE_MODEL_OFFLINE=false

FREECAD_BIN=
PYTHONPATH=
