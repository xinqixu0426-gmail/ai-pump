ACCESS_PASSWORD=change-me
JWT_SECRET=replace-with-random-hex
INTERNAL_SECRET=replace-with-random-hex
CORS_ORIGIN=https://your.domain

NODE_ENV=development
PORT=3002
NEXT_ORIGIN=
# AI 工具调用本机 API 的最长等待时间（1000-120000 毫秒）；写操作不会自动重试。
INTERNAL_API_TIMEOUT_MS=15000

# 通用 MCP 默认关闭。启用后只开放代码白名单中的只读 Query/Preview 工具。
MCP_ENABLED=false
# 单 Agent 可用 MCP_TOKEN；多 Agent 推荐用 MCP_SERVICE_TOKENS 分配独立身份和 token。
# token 必须与 INTERNAL_SECRET/JWT_SECRET/管理密码不同，至少 32 字符，例如 openssl rand -hex 32。
MCP_CLIENT_ID=default-agent
MCP_TOKEN=
# JSON 对象示例（不要提交真实 token）：{"hermes":"...","codex":"..."}
MCP_SERVICE_TOKENS=
# 允许的 Host/Origin，多个值用逗号分隔；CORS_ORIGIN 的 hostname 会自动加入。
MCP_ALLOWED_HOSTS=
MCP_RATE_LIMIT_PER_MINUTE=60
MCP_MAX_RESULT_BYTES=262144

# 数据库备份默认写入项目 backups/；异机目录留空表示只做本机备份。
DB_BACKUP_DIR=
DB_BACKUP_MIRROR_DIR=
AUDIT_RETENTION_DAYS=365

# AI_PROVIDER 默认 auto：普通对话走 DeepSeek，图片识别自动走 Kimi。
# 也可设为 deepseek 或 kimi，强制所有对话使用单一提供商。
# Kimi Coding 订阅凭证不能用于这里，业务助手需要开放平台 API Key。
AI_PROVIDER=auto
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
KIMI_API_KEY=
KIMI_MODEL=kimi-k3
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_REASONING_EFFORT=low
# 留空时按模型默认能力判断；需要显式关闭视觉输入时设为 false。
AI_VISION_ENABLED=
# 默认启用按问题领域缩小模型可见工具集；紧急回退到全部工具时设为 false。
AI_DYNAMIC_TOOL_ROUTING_ENABLED=true

# Knowledge V6 向量能力。混合检索异常时自动回退 FTS/LIKE。
KNOWLEDGE_VECTOR_ENABLED=true
KNOWLEDGE_VECTOR_AUTO_SYNC_ENABLED=true
KNOWLEDGE_HYBRID_SEARCH_ENABLED=true
KNOWLEDGE_VECTOR_BATCH_SIZE=16
KNOWLEDGE_EMBEDDING_MODEL=Xenova/multilingual-e5-small
KNOWLEDGE_EMBEDDING_DIMENSIONS=384
KNOWLEDGE_EMBEDDING_DTYPE=q8
KNOWLEDGE_MODEL_CACHE_DIR=
KNOWLEDGE_MODEL_OFFLINE=false

FREECAD_BIN=
PYTHONPATH=
