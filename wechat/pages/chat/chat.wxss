/* ===== 页面容器 ===== */
.page { display: flex; flex-direction: column; height: 100vh; background: var(--bg); }

/* ===== 消息列表 ===== */
.message-list { flex: 1; padding: 20rpx 24rpx; box-sizing: border-box; }

/* ===== 欢迎界面 ===== */
.welcome { display: flex; flex-direction: column; align-items: center; padding-top: 120rpx; }
.welcome-icon { font-size: 100rpx; margin-bottom: 20rpx; }
.welcome-title { font-size: 40rpx; font-weight: 800; color: var(--primary); margin-bottom: 8rpx; }
.welcome-desc { font-size: 26rpx; color: var(--text-secondary); margin-bottom: 40rpx; }
.quick-actions { width: 100%; padding: 0 20rpx; box-sizing: border-box; }
.quick-btn {
  display: flex; align-items: center; gap: 16rpx;
  padding: 24rpx 28rpx; margin-bottom: 16rpx;
  background: var(--card); border-radius: var(--radius);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  border: 1rpx solid var(--border);
}
.quick-btn:active { background: var(--primary-light); border-color: var(--primary); }
.quick-icon { font-size: 36rpx; }
.quick-text { font-size: 28rpx; font-weight: 500; color: var(--text); }

/* ===== 消息行 ===== */
.msg-container { margin-bottom: 16rpx; }
.msg-row { display: flex; }
.msg-row.user { justify-content: flex-end; }
.msg-row.assistant { justify-content: flex-start; }

.bubble {
  max-width: 75%; padding: 20rpx 28rpx; border-radius: var(--radius-lg);
  font-size: 28rpx; line-height: 1.6; word-break: break-all;
}
.user-bubble { background: var(--primary); color: white; border-bottom-right-radius: 6rpx; }
.assistant-bubble { background: var(--card); color: var(--text); border-bottom-left-radius: 6rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06); }

/* ===== 状态消息 ===== */
.status-msg {
  display: flex; align-items: center; justify-content: center; gap: 10rpx;
  padding: 12rpx 0; font-size: 24rpx; color: var(--text-muted);
}
.status-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--primary); }
.status-dot.pulse { animation: pulse 1.2s ease-in-out infinite; }
.status-dot.done { background: var(--success); }
@keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.3; } }

/* ===== 通用卡片 ===== */
.card-container { margin: 12rpx 0; }
.card {
  background: var(--card); border-radius: var(--radius-lg);
  padding: 24rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  border: 1rpx solid var(--border);
}
.card-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.card-title { font-size: 30rpx; font-weight: 700; color: var(--text); }
.card-badge {
  font-size: 28rpx; font-weight: 800; color: var(--primary);
  background: var(--primary-light); padding: 4rpx 16rpx; border-radius: 20rpx;
}
.card-spec { font-size: 24rpx; color: var(--text-secondary); margin-bottom: 12rpx; }

/* ===== BOM 成本卡片 ===== */
.bom-card { border-left: 6rpx solid var(--primary); }
.card-toggle { text-align: center; padding: 12rpx 0; font-size: 24rpx; color: var(--primary); font-weight: 600; }
.card-details { margin-top: 12rpx; }
.detail-row { display: flex; padding: 10rpx 0; border-bottom: 1rpx solid #f1f5f9; font-size: 24rpx; }
.detail-row.header-row { font-weight: 700; color: var(--text-secondary); border-bottom: 2rpx solid var(--border); }
.col-name { flex: 2; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.col-price { flex: 1; text-align: right; }
.col-qty { flex: 0.6; text-align: center; }
.col-sub { flex: 1; text-align: right; font-weight: 600; }

/* ===== 零件/库存卡片 ===== */
.inventory-card { border-left: 6rpx solid var(--purple); }
.part-item { display: flex; justify-content: space-between; align-items: center; padding: 14rpx 0; border-bottom: 1rpx solid #f1f5f9; }
.part-main { display: flex; flex-direction: column; gap: 4rpx; }
.part-model { font-size: 26rpx; font-weight: 600; }
.part-category { font-size: 22rpx; color: var(--text-muted); }
.part-info { display: flex; gap: 16rpx; font-size: 24rpx; align-items: center; }
.part-price { color: var(--primary); font-weight: 600; }
.part-supplier { color: var(--text-secondary); }
.part-stock { color: var(--success); }
.part-stock.stock-low { color: var(--danger); font-weight: 700; }

/* ===== 订单卡片 ===== */
.order-card { border-left: 6rpx solid var(--success); }
.order-customer { font-size: 26rpx; color: var(--text-secondary); margin-bottom: 12rpx; }
.card-status {
  font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 12rpx; font-weight: 600;
}
.status-待采购 { background: var(--warning-light); color: var(--warning); }
.status-采购中 { background: var(--primary-light); color: var(--primary); }
.status-已完成 { background: var(--success-light); color: var(--success); }
.order-items { margin: 8rpx 0; }
.order-item { display: flex; justify-content: space-between; padding: 8rpx 0; font-size: 24rpx; }
.order-item-cost { color: var(--text-secondary); }
.order-summary { display: flex; gap: 20rpx; padding-top: 12rpx; border-top: 1rpx solid var(--border); font-size: 24rpx; font-weight: 600; }
.profit { color: var(--success); }

/* ===== 运营看板 ===== */
.dashboard-card { border-left: 6rpx solid var(--success); }
.dash-grid { display: flex; justify-content: space-around; padding: 16rpx 0; }
.dash-item { text-align: center; }
.dash-num { display: block; font-size: 40rpx; font-weight: 800; color: var(--primary); }
.dash-label { font-size: 22rpx; color: var(--text-muted); }
.dash-finance { display: flex; gap: 16rpx; padding-top: 12rpx; border-top: 1rpx solid var(--border); font-size: 24rpx; }

/* ===== 对比卡片 ===== */
.compare-card { border-left: 6rpx solid var(--purple); }
.compare-row { display: flex; align-items: center; gap: 12rpx; }
.compare-item { flex: 1; text-align: center; padding: 12rpx; background: var(--purple-light); border-radius: var(--radius); }
.compare-name { display: block; font-weight: 700; font-size: 28rpx; }
.compare-cost { display: block; font-size: 32rpx; font-weight: 800; color: var(--primary); margin: 6rpx 0; }
.compare-parts { font-size: 22rpx; color: var(--text-muted); }
.compare-vs { font-size: 28rpx; font-weight: 800; color: var(--text-muted); }
.compare-diff { text-align: center; margin-top: 12rpx; font-size: 26rpx; font-weight: 600; color: var(--danger); }

/* ===== 采购清单 ===== */
.purchase-card { border-left: 6rpx solid var(--warning); }
.purchase-todo { display: flex; gap: 8rpx; padding: 10rpx 0; border-bottom: 1rpx solid #f1f5f9; font-size: 24rpx; }
.todo-icon { font-size: 28rpx; }
.todo-text { flex: 1; color: var(--text-secondary); }

/* ===== 操作结果 ===== */
.action-card { display: flex; align-items: center; gap: 12rpx; }
.action-card.success { border-left: 6rpx solid var(--success); }
.action-card.error { border-left: 6rpx solid var(--danger); }
.action-icon { font-size: 40rpx; }
.action-text { flex: 1; font-size: 26rpx; }

/* ===== 底部输入栏 ===== */
.input-bar {
  display: flex; align-items: center; gap: 12rpx;
  padding: 16rpx 24rpx; padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--card); border-top: 1rpx solid var(--border);
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.04);
}
.mode-btn {
  width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; border-radius: 50%; background: var(--primary-light);
}
.mode-btn:active { background: var(--primary); }
.input-wrap { flex: 1; display: flex; align-items: center; gap: 12rpx; }
.text-input {
  flex: 1; height: 72rpx; padding: 0 24rpx;
  background: var(--bg); border-radius: 36rpx; font-size: 28rpx;
  border: 1rpx solid var(--border);
}
.send-btn {
  width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center;
  border-radius: 50%; background: #e2e8f0; color: var(--text-muted);
  font-size: 36rpx; font-weight: 700; transition: all 0.2s;
}
.send-btn.active { background: var(--primary); color: white; }
.send-btn.active:active { background: var(--primary-dark); }

/* ===== 语音按钮 ===== */
.voice-wrap { flex: 1; }
.voice-btn {
  height: 80rpx; display: flex; align-items: center; justify-content: center;
  background: var(--primary-light); border: 2rpx solid var(--primary);
  border-radius: 40rpx; font-size: 28rpx; font-weight: 600; color: var(--primary);
}
.voice-btn:active, .voice-btn.recording { background: var(--danger-light); border-color: var(--danger); color: var(--danger); }
.voice-btn.disabled { opacity: 0.5; pointer-events: none; }

/* ===== 录音动画 ===== */
.recording-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  background: rgba(0,0,0,0.3); z-index: 999;
}
.ripple {
  position: absolute; width: 200rpx; height: 200rpx;
  border-radius: 50%; border: 4rpx solid rgba(239,68,68,0.5);
  animation: ripple-out 1.5s ease-out infinite;
}
.r2 { animation-delay: 0.3s; }
.r3 { animation-delay: 0.6s; }
@keyframes ripple-out {
  0% { transform: scale(0.5); opacity: 1; }
  100% { transform: scale(2.5); opacity: 0; }
}
.recording-timer {
  font-size: 48rpx; font-weight: 800; color: white;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3); z-index: 1;
}
